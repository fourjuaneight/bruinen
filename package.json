{
	"name": "bruinen",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"clean": "rm -rf build .svelte-kit",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"start": "BODY_SIZE_LIMIT=12M node build",
		"docker:deploy": "POCKETBASE_URL=http://rivendell-app:8090 docker compose up -d --build"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-node": "6.0.4",
		"@sveltejs/kit": "3.3.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "24.19.2",
		"@vitest/browser-playwright": "5.1.1",
		"barcode-detector": "3.2.4",
		"bwip-js": "4.11.4",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"playwright": "1.65.1",
		"pocketbase": "0.29.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.2.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"undici": "8.12.4",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"vitest-browser-svelte": "3.1.0",
		"zxing-wasm": "3.1.7"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
