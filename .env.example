# Rivendell's PocketBase, as seen from the Bruinen server (not the browser).
# In Docker this defaults to http://rivendell-app:8090 on the rivendell_internal network.
POCKETBASE_URL=http://rivendell-app:8090
# Public origin of Bruinen. adapter-node reads it at runtime for CSRF checks on form actions.
ORIGIN=https://bruinen.<your-tailnet>.ts.net
# Host folder for the Tailscale node's state; create it before the first `docker compose up`.
TAILSCALE_STATE_DIR=/path/to/bruinen/tailscale
# Tailscale auth key for the bruinen node (single-use is fine: TS_AUTH_ONCE keeps the node).
TS_AUTHKEY=
# Cover uploads: Bruinen's own B2 application key (not Rivendell's), limited to the covers
# bucket with only the writeFiles capability. Leave empty to hide the cover upload control.
B2_APP_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
