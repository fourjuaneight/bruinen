# Rivendell's PocketBase, as seen from the Bruinen server (not the browser).
POCKETBASE_URL=http://rivendell-app:8090
# Public origin of Bruinen. adapter-node reads it at runtime for CSRF checks on form actions.
ORIGIN=https://bruinen.<your-tailnet>.ts.net
# Tailscale auth key for the bruinen node.
TS_AUTHKEY=
